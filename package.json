{
  "name": "groundbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Commission-free booking for football grounds: QR → pick slot → pay by UPI → owner approves.",
  "engines": { "node": ">=22.5" },
  "scripts": {
    "dev": "node --no-warnings scripts/dev-server.mjs",
    "test": "node --no-warnings --test tests/*.test.mjs",
    "e2e": "node --no-warnings tests/e2e.mjs",
    "db:migrate": "wrangler d1 migrations apply groundbook --remote",
    "deploy": "wrangler deploy"
  },
  "devDependencies": {
    "wrangler": "^4"
  }
}
